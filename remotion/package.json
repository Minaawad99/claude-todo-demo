{
  "name": "eh-elhekaya-remotion",
  "private": true,
  "description": "Remotion workspace for «إيه الحكاية؟» videos (1080×1920, 60 fps)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts Hello out/hello.mp4",
    "still": "remotion still src/index.ts Hello out/hello.png --frame=60",
    "sync": "node scripts/sync-cartoon.mjs",
    "render:speed-radar": "remotion render src/index.ts SpeedRadar out/speed-radar.mp4 --concurrency=4 --crf=15 --x264-preset=slow --timeout=120000"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
