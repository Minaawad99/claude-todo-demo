{"nodes": [{"id": "playbook", "label": "\u00ab\u0625\u064a\u0647 \u0627\u0644\u062d\u0643\u0627\u064a\u0629\u061f\u00bb video production playbook", "file_type": "document", "source_file": "PLAYBOOK.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "playbook_script_rules", "label": "Script rules (~40 lines, hook number, fixed line 4, spelled numbers)", "file_type": "rationale", "source_file": "PLAYBOOK.md", "source_location": "L5-L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Numbers are spelled out so TTS pronounces them correctly; commas replace '...' because ellipses make the voice pause too long; a surprising number every ~10 lines and a mid-script question keep attention."}, {"id": "playbook_household_analogy", "label": "Household analogy (hand out of car window, balloon in hair)", "file_type": "concept", "source_file": "PLAYBOOK.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "playbook_voice_style_prompt", "label": "Google AI Studio TTS style prompt (casual Egyptian Arabic)", "file_type": "concept", "source_file": "PLAYBOOK.md", "source_location": "L20-L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "playbook_narrator_tightening", "label": "Narrator pace tightening (tighten.py --max 0.25 + atempo 1.08)", "file_type": "concept", "source_file": "PLAYBOOK.md", "source_location": "L29-L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Match the reference's ~7 pauses/min of ~1/3 s; raise atempo up to 1.10 if still over 1:59."}, {"id": "playbook_asr_alignment", "label": "ASR line alignment (align_asr.py + map_timing.py, sherpa-onnx whisper-small)", "file_type": "concept", "source_file": "PLAYBOOK.md", "source_location": "L37-L40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "align.py alone matches by length and fails when the narrator speeds up or slows down (e.g. the intro); ASR matches each chunk to its line by words."}, {"id": "playbook_isometric_3d_style", "label": "Isometric 3D cutaway style (TebEzay.iso, iso.js / iso-scene.js)", "file_type": "rationale", "source_file": "PLAYBOOK.md", "source_location": "L42-L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Front and right walls removed so every part is visible in its real place; no flat 2D drawing of the device; isometric SVG instead of WebGL renders in ~15 minutes."}, {"id": "playbook_color_semantics", "label": "Colour semantics (blue water/air/lift, red heat/thrust, green mechanical, black weight)", "file_type": "concept", "source_file": "PLAYBOOK.md", "source_location": "L48-L55", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "playbook_moving_camera", "label": "Moving camera over one 3D scene (data-cam, ISO.P())", "file_type": "concept", "source_file": "PLAYBOOK.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "playbook_inverter_ac_reference_style", "label": "Reference style: inverter AC video (device in real room, live charts, zoom insets)", "file_type": "rationale", "source_file": "PLAYBOOK.md", "source_location": "L68-L80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placing the device in its real environment lets the viewer understand where it lives and what it works with."}, {"id": "playbook_washing_machine_reference_style", "label": "Reference style: washing machine video (clean technical vector, minimal on-screen text)", "file_type": "rationale", "source_file": "PLAYBOOK.md", "source_location": "L82-L99", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "playbook_audio_mix_rules", "label": "Music & SFX mix rules (sfx.py, cues.json, narrator +15 dB, -14 LUFS)", "file_type": "concept", "source_file": "PLAYBOOK.md", "source_location": "L101-L106", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "playbook_render_publish", "label": "Render & publish (render.js 1080x1920 60fps, cover, title, description)", "file_type": "concept", "source_file": "PLAYBOOK.md", "source_location": "L108-L116", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "playbook_motion_rules", "label": "Motion rules (from awesome-opus5-5-videos)", "file_type": "rationale", "source_file": "PLAYBOOK.md", "source_location": "L118-L134", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One hero element carries the story across cuts; always eased motion except line drawing; vary scale every shot; 3D only when it explains something physical; text stays HTML over the 3D."}, {"id": "playbook_storyboard_rules", "label": "Storyboard rules (12-15 compositions per 30 s, 3 signature moments, works muted)", "file_type": "concept", "source_file": "PLAYBOOK.md", "source_location": "L136-L142", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "playbook_qa_gate", "label": "Quality gate (qa.py PASS/FAIL + contact sheet)", "file_type": "concept", "source_file": "PLAYBOOK.md", "source_location": "L151-L167", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No send before pauses, first frame, loudness and contrast checks pass; a bug-free video is not necessarily a good one, so review the contact sheet as a fresh critic."}], "edges": [{"source": "playbook", "target": "playbook_script_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAYBOOK.md", "source_location": "L5", "weight": 1.0}, {"source": "playbook_script_rules", "target": "playbook_household_analogy", "relation": "referenc