[
 {
  "line": 0,
  "text": "إيه اللي بيحصل بالظبط في الولادة القيصرية؟",
  "start": 0.21,
  "end": 2.73,
  "show_end": 3.03
 },
 {
  "line": 1,
  "text": "فيه بيبي جاي على الدنيا",
  "start": 3.03,
  "end": 4.68,
  "show_end": 4.68
 },
 {
  "line": 1,
  "text": "بس المرة دي مش هيخرج من الطريق الطبيعي",
  "start": 4.68,
  "end": 7.37,
  "show_end": 7.37
 },
 {
  "line": 1,
  "text": "هيخرج من فتحة في بطن الأم وفي الرحم نفسه",
  "start": 7.37,
  "end": 10.14,
  "show_end": 10.44
 },
 {
  "line": 2,
  "text": "والعملية دي من جوه حاجة تبهر",
  "start": 10.44,
  "end": 12.37,
  "show_end": 12.37
 },
 {
  "line": 2,
  "text": "تعالى ندخل أوضة العمليات",
  "start": 12.37,
  "end": 14.13,
  "show_end": 14.73
 },
 {
  "line": 3,
  "text": "أول حاجة: البنج",
  "start": 14.95,
  "end": 15.98,
  "show_end": 15.98
 },
 {
  "line": 3,
  "text": "في أغلب القيصريات اللي بتبقى متحددة قبلها",
  "start": 15.98,
  "end": 19.0,
  "show_end": 19.0
 },
 {
  "line": 3,
  "text": "الأم بتاخد بنج نصفي",
  "start": 19.0,
  "end": 20.38,
  "show_end": 20.38
 },
 {
  "line": 3,
  "text": "في الضهر أو في الحبل الشوكي",
  "start": 20.38,
  "end": 22.27,
  "show_end": 22.57
 },
 {
  "line": 4,
  "text": "ده بيخلّي نصها اللي تحت متخدّر خالص",
  "start": 22.57,
  "end": 25.47,
  "show_end": 25.47
 },
 {
  "line": 4,
  "text": "فبتفضل صاحية ومش حاسة بأي وجع من الجرح",
  "start": 25.47,
  "end": 28.8,
  "show_end": 29.08
 },
 {
  "line": 5,
  "text": "بس ممكن تحس بضغط أو شدّ أو حركة",
  "start": 29.08,
  "end": 31.6,
  "show_end": 32.15
 },
 {
  "line": 6,
  "text": "وتبدأ العملية",
  "start": 32.15,
  "end": 33.2,
  "show_end": 33.2
 },
 {
  "line": 6,
  "text": "الجرّاح بيعمل فتحة بالعرض تحت البطن",
  "start": 33.2,
  "end": 35.74,
  "show_end": 35.74
 },
 {
  "line": 6,
  "text": "فوق عضمة العانة على طول",
  "start": 35.74,
  "end": 37.41,
  "show_end": 37.71
 },
 {
  "line": 7,
  "text": "بس الغريب بقى إنه مش بيقطع كل حاجة مرة واحدة",
  "start": 37.71,
  "end": 40.19,
  "show_end": 40.49
 },
 {
  "line": 8,
  "text": "الأول الجلد",
  "start": 40.49,
  "end": 41.34,
  "show_end": 41.34
 },
 {
  "line": 8,
  "text": "وبعده طبقة الدهون اللي تحته",
  "start": 41.34,
  "end": 43.3,
  "show_end": 43.6
 },
 {
  "line": 9,
  "text": "وبعدها طبقة قوية اسمها الغشاء الليفي",
  "start": 43.6,
  "end": 46.15,
  "show_end": 46.15
 },
 {
  "line": 9,
  "text": "بيفتحها ويبعد عضلات البطن عن بعض من النص بالراحة",
  "start": 46.15,
  "end": 49.43,
  "show_end": 49.43
 },
 {
  "line": 9,
  "text": "من غير ما يقطعها",
  "start": 49.43,
  "end": 50.5,
  "show_end": 50.8
 },
 {
  "line": 10,
  "text": "وكده يبقى وصل لتجويف البطن",
  "start": 50.8,
  "end": 52.9,
  "show_end": 52.9
 },
 {
  "line": 10,
  "text": "ويظهر الرحم",
  "start": 52.9,
  "end": 53.86,
  "show_end": 54.16
 },
 {
  "line": 11,
  "text": "الرحم ده عضلة سميكة",
  "start": 54.16,
  "end": 55.49,
  "show_end": 55.49
 },
 {
  "line": 11,
  "text": "وكبرت أضعاف حجمها طول الحمل",
  "start": 55.49,
  "end": 57.4,
  "show_end": 57.7
 },
 {
  "line": 12,
  "text": "والجرّاح بيعمل فتحة تانية",
  "start": 57.7,
  "end": 59.16,
  "show_end": 59.16
 },
 {
  "line": 12,
  "text": "غالبًا في الجزء اللي تحت منه",
  "start": 59.16,
  "end": 60.68,
  "show_end": 60.98
 },
 {
  "line": 13,
  "text": "وكده بقينا جوه الرحم",
  "start": 60.98,
  "end": 62.59,
  "show_end": 62.59
 },
 {
  "line": 13,
  "text": "ولو كيس المية لسه مقفول",
  "start": 62.59,
  "end": 64.4,
  "show_end": 64.4
 },
 {
  "line": 13,
  "text": "بيفتحه والمية تنزل",
  "start": 64.4,
  "end": 65.92,
  "show_end": 66.22
 },
 {
  "line": 14,
  "text": "وجت اللحظة اللي الكل مستنيها",
  "start": 66.22,
  "end": 68.1,
  "show_end": 68.1
 },
 {
  "line": 14,
  "text": "الجرّاح بيطلّع راس البيبي بالراحة",
  "start": 68.1,
  "end": 70.23,
  "show_end": 70.23
 },
 {
  "line": 14,
  "text": "أو أي جزء فيه يكون قدام الفتحة",
  "start": 70.23,
  "end": 72.11,
  "show_end": 72.41
 },
 {
  "line": 15,
  "text": "وساعات مساعده بيضغط ضغطة خفيفة",
  "start": 72.41,
  "end": 74.16,
  "show_end": 74.16
 },
 {
  "line": 15,
  "text": "على البطن من فوق عشان يساعده",
  "start": 74.16,
  "end": 75.71,
  "show_end": 76.01
 },
 {
  "line": 16,
  "text": "وبعدها الكتاف",
  "start": 76.01,
  "end": 77.02,
  "show_end": 77.02
 },
 {
  "line": 16,
  "text": "وبعدين باقي الجسم",
  "start": 77.02,
  "end": 78.28,
  "show_end": 78.58
 },
 {
  "line": 17,
  "text": "والبيبي خرج!",
  "start": 78.58,
  "end": 79.32,
  "show_end": 79.62
 },
 {
  "line": 18,
  "text": "الفريق بيكشف عليه على طول",
  "start": 79.62,
  "end": 81.38,
  "show_end": 81.38
 },
 {
  "line": 18,
  "text": "بيتنفس كويس؟",
  "start": 81.38,
  "end": 82.21,
  "show_end": 82.21
 },
 {
  "line": 18,
  "text": "عضلاته كويسة؟",
  "start": 82.21,
  "end": 83.13,
  "show_end": 83.13
 },
 {
  "line": 18,
  "text": "حالته عامة كويسة؟",
  "start": 83.13,
  "end": 84.3,
  "show_end": 84.6
 },
 {
  "line": 19,
  "text": "والحبل السُّري بيتربط ويتقص",
  "start": 84.6,
  "end": 86.3,
  "show_end": 86.3
 },
 {
  "line": 19,
  "text": "وغالبًا بيستنوا شوية قبلها لو الظروف تسمح",
  "start": 86.3,
  "end": 88.92,
  "show_end": 89.22
 },
 {
  "line": 20,
  "text": "بس العملية لسه ما خلصتش",
  "start": 89.22,
  "end": 91.08,
  "show_end": 91.08
 },
 {
  "line": 20,
  "text": "المشيمة اللي كانت بتأكّل البيبي وبتديله",
  "start": 91.08,
  "end": 94.31,
  "show_end": 94.31
 },
 {
  "line": 20,
  "text": "أكسجين طول الحمل لازم تطلع هي كمان",
  "start": 94.31,
  "end": 97.04,
  "show_end": 97.04
 },
 {
  "line": 20,
  "text": "والجرّاح بيشيلها ويتأكد إن الرحم مافيهوش نزيف",
  "start": 97.04,
  "end": 100.76,
  "show_end": 100.98
 },
 {
  "line": 21,
  "text": "ودلوقتي وقت التقفيل",
  "start": 100.98,
  "end": 102.23,
  "show_end": 102.23
 },
 {
  "line": 21,
  "text": "فتحة الرحم بتتخيّط",
  "start": 102.23,
  "end": 103.32,
  "show_end": 103.32
 },
 {
  "line": 21,
  "text": "ويتأكد إن النزيف وقف",
  "start": 103.32,
  "end": 104.57,
  "show_end": 104.87
 },
 {
  "line": 22,
  "text": "وبعدها طبقات البطن بتتقفل واحدة واحدة",
  "start": 104.87,
  "end": 107.28,
  "show_end": 107.28
 },
 {
  "line": 22,
  "text": "الغشاء الليفي",
  "start": 107.28,
  "end": 108.18,
  "show_end": 108.18
 },
 {
  "line": 22,
  "text": "وبعده الجلد",
  "start": 108.18,
  "end": 108.93,
  "show_end": 109.23
 },
 {
  "line": 23,
  "text": "أما العضلات فغالبًا مش بتحتاج خياطة",
  "start": 109.23,
  "end": 111.44,
  "show_end": 111.44
 },
 {
  "line": 23,
  "text": "عشان هي اتبعدت عن بعض بس",
  "start": 111.44,
  "end": 112.89,
  "show_end": 112.89
 },
 {
  "line": 23,
  "text": "ما اتقطعتش",
  "start": 112.89,
  "end": 113.58,
  "show_end": 113.83
 },
 {
  "line": 24,
  "text": "وهنا المفاجأة",
  "start": 113.83,
  "end": 114.8,
  "show_end": 114.8
 },
 {
  "line": 24,
  "text": "في القيصرية العادية البيبي ممكن",
  "start": 114.8,
  "end": 116.99,
  "show_end": 116.99
 },
 {
  "line": 24,
  "text": "يطلع في أول كام دقيقة بس",
  "start": 116.99,
  "end": 118.53,
  "show_end": 118.83
 },
 {
  "line": 25,
  "text": "لكن التقفيل بأمان بياخد وقت أطول بكتير",
  "start": 118.83,
  "end": 121.95,
  "show_end": 121.95
 },
 {
  "line": 25,
  "text": "العملية كلها بتاخد حوالي من أربعين لستين دقيقة",
  "start": 121.95,
  "end": 125.75,
  "show_end": 126.05
 },
 {
  "line": 26,
  "text": "والقيصرية على عكس الولادة الطبيعية",
  "start": 126.05,
  "end": 128.4,
  "show_end": 128.4
 },
 {
  "line": 26,
  "text": "عملية كبيرة في البطن",
  "start": 128.4,
  "end": 129.73,
  "show_end": 129.73
 },
 {
  "line": 26,
  "text": "والاستشفاء منها بياخد كام أسبوع",
  "start": 129.73,
  "end": 131.84,
  "show_end": 131.84
 },
 {
  "line": 26,
  "text": "لحد ما الرحم والأنسجة والجرح يلموا",
  "start": 131.84,
  "end": 134.11,
  "show_end": 134.41
 },
 {
  "line": 27,
  "text": "يعني القيصرية اللي شكلها طريقة سريعة للولادة",
  "start": 134.41,
  "end": 137.04,
  "show_end": 137.04
 },
 {
  "line": 27,
  "text": "هي في الحقيقة عملية مترتبة بالدقيقة: بنج",
  "start": 137.04,
  "end": 139.33,
  "show_end": 139.33
 },
 {
  "line": 27,
  "text": "وطبقات أنسجة",
  "start": 139.33,
  "end": 140.09,
  "show_end": 140.09
 },
 {
  "line": 27,
  "text": "وتقنيات جراحية دقيقة",
  "start": 140.09,
  "end": 141.34,
  "show_end": 141.34
 },
 {
  "line": 27,
  "text": "وفريق طبي كامل",
  "start": 141.34,
  "end": 142.17,
  "show_end": 142.47
 },
 {
  "line": 28,
  "text": "كلهم شغالين على هدف واحد",
  "start": 142.47,
  "end": 144.37,
  "show_end": 144.37
 },
 {
  "line": 28,
  "text": "إن الأم والبيبي يعدّوا الولادة بسلام",
  "start": 144.37,
  "end": 147.22,
  "show_end": 148.42
 }
]